rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/travelDdak/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['revision', 'state'])
        && request.resource.data.revision is int
        && request.resource.data.state is map
        && request.resource.data.state.keys().hasOnly(['version', 'trips', 'recents'])
        && request.resource.data.state.version is int
        && request.resource.data.state.trips is list
        && request.resource.data.state.trips.size() <= 100
        && request.resource.data.state.recents is list
        && request.resource.data.state.recents.size() <= 8;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}